{
  "ConnectionStrings": {
    // MongoDB. directConnection=true lets a single-node replica set in a container be reached from the host
    "Mongo": "mongodb://localhost:27017/?directConnection=true",
    // SQL Server with AdventureWorks2016, only for the loaders that regenerate the JSON files
    "AdventureWorks": "Server=localhost;Database=AdventureWorks2016;Integrated Security=true;TrustServerCertificate=true;Application Name=SimpleTalkMongoDb"
  },

  // Default MongoDB database name
  "MongoDbName": "simpleTalk",
  // Default MongoDB database name for demonstrating the $lookup operator
  "SampleLookup": "sampleLookup",

  // Default MongoDB collection names
  "MongoCollectionName": "adventureWorks2016",
  "MongoSpecialOfferCollectionName": "specialOffer",
  "MongoProducts": "products",

  // Collections used to demonstrate the $lookup operator
  "MongoPersons": "person",
  "MongoMeanings": "meanings",
  "MongoItems": "items",
  "MongoNullOrNonExisting": "collNullNonExistingElements",
  "MongoInventory": "collInventory",

  // The user the Auth example signs in as; the seed command creates it
  "SampleUser": "usrSimpleTalk",
  "SamplePassword": "pwdSimpleTalk",

  // A local Ollama, only for the loader that regenerates Data/ProductEmbeddings.json
  "Ollama": {
    "Url": "http://localhost:11434",
    "Model": "nomic-embed-text"
  },

  // T-SQL statements used to generate the JSON files
  "TSQL": "SELECT * FROM Sales.SalesOrderHeader; SELECT * FROM Sales.SalesOrderDetail;",
  "TSQLSpecialOffers": "SELECT SpecialOfferID, Type, Description, Category FROM Sales.SpecialOffer;",
  "TSQLProducts": "SELECT ProductID, ProductNumber, pp.Name, PS.Name SubKategoryName, pc.Name CategoryName FROM Production.Product pp LEFT OUTER JOIN Production.ProductSubcategory PS ON pp.ProductSubcategoryID = PS.ProductSubcategoryID LEFT OUTER JOIN Production.ProductCategory pc ON PS.ProductCategoryID = pc.ProductCategoryID;"
}
